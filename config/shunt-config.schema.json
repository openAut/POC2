{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openAut POC2 shunt-group config",
  "type": "object",
  "required": ["site", "edge_node", "mqtt", "rs485", "io", "heating_curve", "control", "pump", "safety"],
  "properties": {
    "site": { "type": "string", "minLength": 1 },
    "control_interval_seconds": { "type": "number", "minimum": 1, "default": 10 },

    "edge_node": {
      "type": "object",
      "required": ["ip", "ssh_user", "deploy_dir"],
      "properties": {
        "ip": { "type": "string" },
        "ssh_user": { "type": "string" },
        "deploy_dir": { "type": "string" }
      }
    },

    "mqtt": {
      "type": "object",
      "required": ["host"],
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "default": 1883 },
        "tls": { "type": "boolean", "default": false },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "client_id": { "type": "string" }
      }
    },

    "rs485": {
      "type": "object",
      "required": ["port", "baudrate"],
      "properties": {
        "port": { "type": "string" },
        "baudrate": { "type": "integer" },
        "parity": { "type": "string", "enum": ["N", "E", "O"], "default": "N" },
        "stopbits": { "type": "integer", "default": 1 },
        "bytesize": { "type": "integer", "default": 8 },
        "timeout": { "type": "number", "default": 1.0 }
      }
    },

    "io": {
      "type": "object",
      "required": ["supply_temp", "return_temp", "outdoor_temp", "valve_position", "pump_start", "pump_alarm", "pump_run"],
      "additionalProperties": {
        "type": "object",
        "required": ["slave_id", "function_code", "address"],
        "properties": {
          "module": { "type": "string" },
          "slave_id": { "type": "integer", "minimum": 1, "maximum": 247 },
          "function_code": { "type": "integer", "enum": [3, 4] },
          "address": { "type": "integer", "minimum": 0 },
          "data_type": { "type": "string", "enum": ["int16", "uint16", "int32", "uint32", "float32"], "default": "int16" },
          "scale": { "type": "number", "default": 1 },
          "offset": { "type": "number", "default": 0 },
          "unit": { "type": "string" },
          "min_plausible": { "type": "number" },
          "max_plausible": { "type": "number" },
          "output_min": { "type": "number" },
          "output_max": { "type": "number" }
        }
      }
    },

    "heating_curve": {
      "type": "object",
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["outdoor", "supply"],
            "properties": {
              "outdoor": { "type": "number" },
              "supply": { "type": "number" }
            }
          }
        }
      }
    },

    "control": {
      "type": "object",
      "required": ["kp", "ki"],
      "properties": {
        "kp": { "type": "number" },
        "ki": { "type": "number" },
        "valve_min_pct": { "type": "number", "default": 0 },
        "valve_max_pct": { "type": "number", "default": 100 },
        "deadband_c": { "type": "number", "default": 0.0 }
      }
    },

    "pump": {
      "type": "object",
      "required": ["start_below_c"],
      "properties": {
        "start_below_c": { "type": "number" },
        "hysteresis_c": { "type": "number", "default": 1.0 }
      }
    },

    "safety": {
      "type": "object",
      "required": ["mode", "watchdog_timeout_s"],
      "properties": {
        "mode": { "type": "string", "enum": ["hold_last", "close_stop", "frost_protect"], "default": "hold_last" },
        "watchdog_timeout_s": { "type": "number" },
        "max_consecutive_read_failures": { "type": "integer", "default": 5 }
      }
    }
  }
}
